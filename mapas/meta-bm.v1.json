{
  "version": 1,
  "name": "meta-bm",
  "notes": "Mapa inicial derivado das etapas do assistente Python. Variantes novas entram pelo gravador.",
  "nodes": [
    {
      "id": "login",
      "match": {
        "urlIncludes": [
          "facebook.com/login",
          "business.facebook.com/login",
          "business/loginpage",
          "login_options",
          "config_ref=biz_login"
        ],
        "anyText": [
          "Entrar",
          "Log in",
          "Senha",
          "Password",
          "Comece a usar",
          "Continuar com o Facebook",
          "Continue with Facebook"
        ]
      },
      "human": "login",
      "onMiss": ["portfolio.form", "unknown"]
    },
    {
      "id": "checkpoint.captcha",
      "match": {
        "anyText": ["captcha", "Não sou um robô", "I'm not a robot", "Verificação de segurança"]
      },
      "human": "captcha",
      "onMiss": ["unknown"]
    },
    {
      "id": "portfolio.unavailable",
      "step": "portfolio",
      "match": {
        "urlIncludes": ["business.facebook.com/latest/home", "business_id="],
        "anyText": [
          "Não é possível acessar o Meta Business Suite",
          "You can't access Meta Business Suite",
          "não tem acesso a Páginas do Facebook",
          "doesn't have access to Facebook Pages"
        ]
      },
      "onMiss": ["portfolio.settings_users", "portfolio.switcher", "unknown"]
    },
    {
      "id": "portfolio.settings_users",
      "step": "portfolio",
      "match": {
        "urlIncludes": ["/latest/settings/business_users"]
      },
      "onMiss": ["portfolio.switcher", "unknown"]
    },
    {
      "id": "portfolio.existing",
      "step": "portfolio",
      "match": {
        "urlIncludes": ["business.facebook.com/latest/home", "nav_ref=bm_home_redirect"],
        "anyText": [
          "Meta Business Suite",
          "Etapas para começar",
          "Conheça o Meta Business Suite"
        ]
      },
      "human": "unknown_screen",
      "onMiss": ["portfolio.form", "unknown"]
    },
    {
      "id": "portfolio.switcher",
      "step": "portfolio",
      "match": {
        "anyText": ["Portfólios empresariais", "Business portfolios"]
      },
      "onMiss": ["portfolio.create", "portfolio.form", "unknown"]
    },
    {
      "id": "portfolio.create",
      "step": "portfolio",
      "match": {
        "anyText": [
          "Nome do portfólio empresarial",
          "Email comercial",
          "Business portfolio name"
        ]
      },
      "fields": ["razao_social", "nome", "sobrenome", "email_comercial"],
      "onMiss": ["empresa.info", "login", "unknown"]
    },
    {
      "id": "portfolio.add_people",
      "step": "portfolio",
      "match": {
        "anyText": [
          "Adicione pessoas a este portfólio empresarial",
          "Add people to this business portfolio"
        ]
      },
      "onMiss": ["portfolio.confirm", "portfolio.switcher", "unknown"]
    },
    {
      "id": "portfolio.confirm",
      "step": "portfolio",
      "match": {
        "anyText": [
          "Analise e confirme seu portfólio empresarial",
          "Review and confirm your business portfolio"
        ]
      },
      "onMiss": ["portfolio.switcher", "portfolio.existing", "unknown"]
    },
    {
      "id": "portfolio.add_assets",
      "step": "portfolio",
      "match": {
        "anyText": [
          "O que você quer adicionar a este portfólio empresarial",
          "What do you want to add to this business portfolio",
          "Não há nada disponível para ser reivindicado"
        ]
      },
      "onMiss": ["portfolio.switcher", "portfolio.existing", "unknown"]
    },
    {
      "id": "portfolio.landing",
      "step": "portfolio",
      "match": {
        "urlIncludes": ["adsmanager/onboarding"],
        "anyText": [
          "Começar",
          "Criar portfólio empresarial",
          "Precisa criar um portfólio empresarial primeiro?",
          "Alcance as pessoas certas com o Gerenciador de Anúncios",
          "Get started",
          "Create a business portfolio"
        ]
      },
      "onMiss": ["portfolio.form", "unknown"]
    },
    {
      "id": "portfolio.form",
      "step": "portfolio",
      "match": {
        "urlIncludes": ["adsmanager/onboarding", "create_business"],
        "anyText": [
          "Nome da sua conta e empresa",
          "Your business and account name",
          "Seu email comercial",
          "Business email",
          "Crie seu portfólio empresarial",
          "Create a business portfolio"
        ]
      },
      "fields": ["razao_social", "responsavel", "email_comercial"],
      "onMiss": ["empresa.info", "login", "unknown"]
    },
    {
      "id": "empresa.details_form",
      "step": "empresa",
      "match": {
        "urlIncludes": ["/latest/settings/business_info"],
        "anyText": [
          "Editar detalhes da empresa",
          "Edit business details",
          "Identificação fiscal (EIN)",
          "Tax ID (EIN)"
        ]
      },
      "fields": ["razao_social", "endereco", "cidade", "estado", "cep", "telefone", "site", "cnpj"],
      "onMiss": ["empresa.info", "unknown"]
    },
    {
      "id": "empresa.info",
      "step": "empresa",
      "match": {
        "urlIncludes": ["/latest/settings/business_info"],
        "anyText": ["Razão social da empresa", "Business details", "Identificação fiscal"]
      },
      "fields": ["razao_social", "endereco", "cidade", "estado", "cep", "telefone", "site", "cnpj"],
      "onMiss": ["whatsapp.account", "unknown"]
    },
    {
      "id": "whatsapp.account",
      "step": "whatsapp",
      "match": {
        "urlIncludes": ["whatsapp_account"],
        "anyText": ["WhatsApp Business", "Nome de exibição"]
      },
      "fields": ["razao_social", "site"],
      "onMiss": ["security_center.home", "unknown"]
    },
    {
      "id": "security_center.home",
      "step": "verificacao_dados",
      "match": {
        "urlIncludes": ["/latest/settings/security_center"],
        "anyText": ["Central de segurança", "Security Center", "Iniciar verificação", "Start verification"]
      },
      "onMiss": ["verificacao.dados", "verificacao.documento", "unknown"]
    },
    {
      "id": "verificacao.dados",
      "step": "verificacao_dados",
      "match": {
        "anyText": ["Identificação Fiscal da Empresa", "Business verification"]
      },
      "fields": ["cnpj", "razao_social"],
      "onMiss": ["verificacao.documento", "unknown"]
    },
    {
      "id": "verificacao.documento",
      "step": "verificacao_documento",
      "match": {
        "anyText": ["Carregar documentos", "Upload documents", "Cadastro Nacional de Pessoa Jurídica"]
      },
      "onMiss": ["verificacao.sms", "unknown"]
    },
    {
      "id": "verificacao.sms",
      "step": "verificacao_sms",
      "match": {
        "anyText": ["Código de confirmação", "Confirmation code", "SMS"]
      },
      "human": "otp",
      "onMiss": ["verificacao.nome", "unknown"]
    },
    {
      "id": "verificacao.nome",
      "step": "verificacao_nome",
      "match": {
        "anyText": ["Nome comercial registrado", "Legal name"]
      },
      "fields": ["razao_social"],
      "onMiss": ["verificacao.endereco", "unknown"]
    },
    {
      "id": "verificacao.endereco",
      "step": "verificacao_endereco",
      "match": {
        "anyText": ["Código postal", "Postal code"]
      },
      "fields": ["endereco", "cidade", "estado", "cep"],
      "onMiss": ["verificacao.contato", "unknown"]
    },
    {
      "id": "verificacao.contato",
      "step": "verificacao_contato",
      "match": {
        "anyText": ["Telefone", "Website"]
      },
      "fields": ["telefone", "site"],
      "onMiss": ["unknown"]
    },
    {
      "id": "unknown",
      "match": {},
      "human": "unknown_screen"
    }
  ]
}
